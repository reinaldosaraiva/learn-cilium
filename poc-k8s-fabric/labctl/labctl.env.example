# labctl.env — valores do host (ignorado pelo git; copie para labctl.env).
# Nenhum valor real aqui; preencha no host.

# Raiz do kit (scripts/00-99, topo/, studies/)
LAB_ROOT=/opt/poc-k8s-fabric

# Kubeconfigs dos clusters kind (caminhos no host)
K01_KUBECONFIG=
P003_KUBECONFIG=
OVNK_KUBECONFIG=/root/.kube/ovnk.config

# Perfis P004-S003 (evpn-fabric e ovnk)
EVPN_FABRIC_IMAGE=ovn/ovn-multi-node:latest
EVPN_FABRIC_IMAGE_ID=sha256:eda2364d9cfbec6dd26f54b335c37efa9dade64ffdccbff374b5c50ae64ce52a
OVNK_VERSION=v1.4.0
OVNK_IMAGE=ghcr.io/ovn-kubernetes/ovn-kubernetes/ovn-kube-ubuntu:release-1.4
OVNK_IMAGE_DIGEST=sha256:fe68c334f7d4ed6d2ce59a02d65296c9133a450e896bac79a2d7558031629062
KUBEVIRT_VERSION=v1.9.0
FRR_K8S_VERSION=v0.0.27
MULTUS_VERSION=v4.1.4
