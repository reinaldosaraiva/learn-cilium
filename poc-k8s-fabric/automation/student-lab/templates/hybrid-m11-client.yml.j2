apiVersion: apps/v1
kind: Deployment
metadata:
  name: p010-hyb-{{ student_state.run_id.split('-')[-1][:12] }}-client
  namespace: p010-hyb-{{ student_state.run_id.split('-')[-1][:12] }}
  labels:
    app: p010-hyb-client
    p010-student-owner: {{ student_state.owner_token }}
    p010-student-run: {{ student_state.run_id }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: p010-hyb-client
      p010-student-owner: {{ student_state.owner_token }}
      p010-student-run: {{ student_state.run_id }}
  template:
    metadata:
      labels:
        app: p010-hyb-client
        p010-student-owner: {{ student_state.owner_token }}
        p010-student-run: {{ student_state.run_id }}
    spec:
      nodeSelector:
        topology.kubernetes.io/rack: rack1
      containers:
        - name: netshoot
          image: docker.io/nicolaka/netshoot@sha256:b09d9b21381f47a79b3cbcb30da25266dc17186ea00ae65e99fdc51396f48e70
          command: [/bin/sleep, infinity]
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
