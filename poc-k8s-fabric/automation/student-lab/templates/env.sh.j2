export LAB_KUBECONFIG={{ student_state.kubeconfig | quote }}
export LAB_CONTEXT={{ student_state.context | quote }}
export LAB_API_SERVER={{ student_state.api_server | quote }}
export LAB_CLUSTER_UID={{ student_state.cluster_uid | quote }}
export LAB_CILIUM_NS='kube-system'
export LAB_RUN_ID={{ (student_state.exercise_session.id if student_state.profile == 'iniciantes' else student_state.run_id) | quote }}
export LAB_GUIDE_REVISION={{ student_guide_revision | quote }}
export PATH={{ student_tool_dir | quote }}:"${PATH}"
export HUBBLE_MODE={{ student_profile.hubble_mode | quote }}
{% if student_state.profile == 'iniciantes' %}
export LAB_NS={{ student_state.exercise_session.namespace | quote }}
export LAB_DIR={{ (student_repo_root ~ '/poc-k8s-fabric/k8s/p010-iniciantes') | quote }}
export LAB_GUIDE={{ (student_repo_root ~ '/poc-k8s-fabric/docs/ebpf-cilium-iniciantes.md') | quote }}
export LAB_DIR_REL='poc-k8s-fabric/k8s/p010-iniciantes'
export LAB_GUIDE_REL='poc-k8s-fabric/docs/ebpf-cilium-iniciantes.md'
export HUBBLE_SERVER='127.0.0.1:4245'
{% elif student_state.profile == 'fundamentos' %}
export K01_KUBECONFIG={{ student_state.kubeconfig | quote }}
export K01_CONTEXT={{ student_state.context | quote }}
export K01_UID={{ student_state.cluster_uid | quote }}
export K01_CLUSTER_UID={{ student_state.cluster_uid | quote }}
export LAB_NS='default'
export LAB_DIR={{ (student_repo_root ~ '/poc-k8s-fabric/k8s') | quote }}
export LAB_GUIDE={{ (student_repo_root ~ '/poc-k8s-fabric/docs/lab-guide-student.md') | quote }}
export LAB_DIR_REL='poc-k8s-fabric/k8s'
export LAB_GUIDE_REL='poc-k8s-fabric/docs/lab-guide-student.md'
export HUBBLE_SERVER='127.0.0.1:4245'
{% else %}
export STUDY_KUBECONFIG={{ student_state.kubeconfig | quote }}
export STUDY_CONTEXT={{ student_state.context | quote }}
export STUDY_CLUSTER_UID={{ student_state.cluster_uid | quote }}
export LAB_EXERCISE={{ student_state.exercise | quote }}
{% if student_state.wireguard_mode | length > 0 %}
export LAB_WG={{ student_state.wireguard_mode | quote }}
{% endif %}
export LAB_NS='p003-gateway'
export LAB_DIR={{ (student_repo_root ~ '/poc-k8s-fabric/studies/p003') | quote }}
export LAB_GUIDE={{ (student_repo_root ~ '/poc-k8s-fabric/docs/lab-guide-student.md') | quote }}
export LAB_DIR_REL='poc-k8s-fabric/studies/p003'
export LAB_GUIDE_REL='poc-k8s-fabric/docs/lab-guide-student.md'
{% endif %}
