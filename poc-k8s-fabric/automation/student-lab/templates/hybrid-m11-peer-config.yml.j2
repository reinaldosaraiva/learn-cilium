apiVersion: cilium.io/v2
kind: CiliumBGPPeerConfig
metadata:
  name: p010-hyb-{{ student_state.run_id.split('-')[-1][:12] }}-peer
  labels:
    p010-student-owner: {{ student_state.owner_token }}
    p010-student-run: {{ student_state.run_id }}
spec:
  timers:
    connectRetryTimeSeconds: 5
    holdTimeSeconds: 9
    keepAliveTimeSeconds: 3
  gracefulRestart:
    enabled: true
    restartTimeSeconds: 30
  ebgpMultihop: 1
  families:
    - afi: ipv4
      safi: unicast
      advertisements:
        matchLabels:
          p010-student-owner: {{ student_state.owner_token }}
          p010-student-run: {{ student_state.run_id }}
