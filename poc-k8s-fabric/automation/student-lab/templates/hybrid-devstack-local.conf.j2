[[local|localrc]]
ADMIN_PASSWORD={{ student_hybrid_credentials.admin_password }}
DATABASE_PASSWORD={{ student_hybrid_credentials.database_password }}
RABBIT_PASSWORD={{ student_hybrid_credentials.rabbit_password }}
SERVICE_PASSWORD={{ student_hybrid_credentials.service_password }}
HOST_IP=10.0.2.15
DEST=/opt/stack
RECLONE=False
USE_SCREEN=False
ENABLED_SERVICES=key,mysql,rabbit,q-svc,q-agt,q-dhcp,q-l3,q-dr,q-dr-agent
LIBS_FROM_GIT=
USER_UNITS=False
NEUTRON_REPO=https://github.com/openstack/neutron.git
NEUTRON_BRANCH={{ student_profile.hybrid_m11.neutron_revision }}
KEYSTONE_REPO=https://github.com/openstack/keystone.git
KEYSTONE_BRANCH={{ student_profile.hybrid_m11.keystone_revision }}
REQUIREMENTS_REPO=https://github.com/openstack/requirements.git
REQUIREMENTS_BRANCH={{ student_profile.hybrid_m11.requirements_revision }}
enable_plugin neutron-dynamic-routing https://github.com/openstack/neutron-dynamic-routing.git {{ student_profile.hybrid_m11.neutron_dynamic_routing_revision }}
Q_AGENT=openvswitch
Q_ML2_PLUGIN_MECHANISM_DRIVERS=openvswitch
Q_ML2_PLUGIN_TYPE_DRIVERS=local,flat
Q_ML2_TENANT_NETWORK_TYPE=local
Q_ML2_PLUGIN_EXT_DRIVERS=port_security
Q_SERVICE_PLUGIN_CLASSES=neutron.services.l3_router.l3_router_plugin.L3RouterPlugin
NEUTRON_PORT_SECURITY=True
ENABLE_TENANT_TUNNELS=False
ENABLE_TENANT_VLANS=False
OVS_ENABLE_TUNNELING=False
Q_USE_SECGROUP=True
Q_BUILD_OVS_FROM_GIT=False
Q_NOTIFY_NOVA_PORT_STATUS_CHANGES=False
Q_NOTIFY_NOVA_PORT_DATA_CHANGES=False
NEUTRON_CREATE_INITIAL_NETWORKS=False
PUBLIC_INTERFACE={{ student_state.hybrid.m11.network.provider_interface }}
PUBLIC_BRIDGE=br-ex
OVS_PHYSICAL_BRIDGE=br-ex
PHYSICAL_NETWORK=m11public
PUBLIC_PHYSICAL_NETWORK=m11public
OVS_BRIDGE_MAPPINGS=m11public:br-ex
Q_USE_PROVIDERNET_FOR_PUBLIC=True
Q_USE_PUBLIC_VETH=False
Q_ASSIGN_GATEWAY_TO_PUBLIC_BRIDGE=False
DR_MODE=allinone
BGP_ROUTER_ID={{ student_state.hybrid.m11.network.provider_speaker_ip }}
VERBOSE=False
LOGFILE=
SYSLOG=False
ENABLE_DEBUG_LOG_LEVEL=False
DATABASE_QUERY_LOGGING=False
