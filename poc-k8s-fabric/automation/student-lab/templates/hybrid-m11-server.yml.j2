apiVersion: apps/v1
kind: Deployment
metadata:
  name: p010-hyb-{{ student_state.run_id.split('-')[-1][:12] }}-server
  namespace: p010-hyb-{{ student_state.run_id.split('-')[-1][:12] }}
  labels:
    app: p010-hyb-server
    p010-student-owner: {{ student_state.owner_token }}
    p010-student-run: {{ student_state.run_id }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: p010-hyb-server
      p010-student-owner: {{ student_state.owner_token }}
      p010-student-run: {{ student_state.run_id }}
  template:
    metadata:
      labels:
        app: p010-hyb-server
        p010-student-owner: {{ student_state.owner_token }}
        p010-student-run: {{ student_state.run_id }}
    spec:
      nodeSelector:
        topology.kubernetes.io/rack: rack2
      containers:
        - name: agnhost
          image: registry.k8s.io/e2e-test-images/agnhost:2.47
          args: [netexec, --http-port=8080]
          ports:
            - name: http
              containerPort: 8080
          readinessProbe:
            httpGet:
              path: /healthz
              port: 8080
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
