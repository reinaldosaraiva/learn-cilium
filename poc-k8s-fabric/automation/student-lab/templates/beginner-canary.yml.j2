apiVersion: apps/v1
kind: Deployment
metadata:
  name: http-canary
  namespace: {{ student_canary_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: http-canary
  template:
    metadata:
      labels:
        app: http-canary
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        fsGroup: 1000
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: http
          image: busybox:1.36.1
          command: [sh, -c, "echo student-canary-ok > /www/index.html; exec httpd -f -p 8080 -h /www"]
          ports:
            - { name: http, containerPort: 8080 }
          readinessProbe:
            httpGet: { path: /, port: http }
          resources:
            requests: { cpu: 5m, memory: 8Mi }
            limits: { cpu: 100m, memory: 32Mi }
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: [ALL]
            readOnlyRootFilesystem: true
          volumeMounts:
            - { name: web, mountPath: /www }
      volumes:
        - name: web
          emptyDir: {}
---
apiVersion: v1
kind: Service
metadata:
  name: http-canary
  namespace: {{ student_canary_namespace }}
spec:
  selector:
    app: http-canary
  ports:
    - { name: http, port: 8080, targetPort: http }
