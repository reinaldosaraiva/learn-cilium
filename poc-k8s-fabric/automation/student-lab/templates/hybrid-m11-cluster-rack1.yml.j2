apiVersion: cilium.io/v2
kind: CiliumBGPClusterConfig
metadata:
  name: p010-hyb-{{ student_state.run_id.split('-')[-1][:12] }}-rack1
  labels:
    p010-student-owner: {{ student_state.owner_token }}
    p010-student-run: {{ student_state.run_id }}
spec:
  nodeSelector:
    matchLabels:
      topology.kubernetes.io/rack: rack1
  bgpInstances:
    - name: rack1
      localASN: 65301
      peers:
        - name: neutron-speaker
          peerASN: 65201
          peerAddress: 10.30.1.1
          peerConfigRef:
            name: p010-hyb-{{ student_state.run_id.split('-')[-1][:12] }}-peer
