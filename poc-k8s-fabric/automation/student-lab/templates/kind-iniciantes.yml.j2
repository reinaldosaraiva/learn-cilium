kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
networking:
  disableDefaultCNI: true
  kubeProxyMode: none
  podSubnet: 10.244.0.0/16
  serviceSubnet: 10.96.0.0/12
nodes:
  - role: control-plane
    image: {{ student_tool_versions.kind_node_image }}
    extraMounts:
      - hostPath: {{ student_owner_token_file | to_json }}
        containerPath: /etc/p010-student/owner-token
        readOnly: true
    kubeadmConfigPatches:
      - |
        kind: InitConfiguration
        nodeRegistration:
          kubeletExtraArgs:
            node-labels: "p010-student-owner={{ student_state.owner_token }}"
